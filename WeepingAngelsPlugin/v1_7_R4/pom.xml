<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.example</groupId>
        <artifactId>weeping-angels-parent</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>weeping-angels-v1_7_R4</artifactId>
    <packaging>jar</packaging>
    <name>WeepingAngels v1_7_R4 (Legacy 1.7.10)</name>
    <description>NMS implementation module for Spigot/Bukkit 1.7.10 (Java 8)</description>

    <properties>
        <java.version>${java.version.legacy}</java.version>
        <maven.compiler.source>1.8</maven.compiler.source>
        <maven.compiler.target>1.8</maven.compiler.target>
    </properties>

    <repositories>
        <!-- PaperMC has better legacy Spigot artifact coverage -->
        <repository>
            <id>papermc</id>
            <url>https://repo.papermc.io/repository/maven-public/</url>
        </repository>
    </repositories>

    <dependencies>
        <!-- Core Abstraction Module -->
        <dependency>
            <groupId>com.example</groupId>
            <artifactId>weeping-angels-core</artifactId>
        </dependency>
        
        <!-- Use Spigot API 1.10 as earliest available - compatible with 1.7-1.10 era code -->
        <dependency>
            <groupId>org.spigotmc</groupId>
            <artifactId>spigot-api</artifactId>
            <version>1.10-R0.1-SNAPSHOT</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Compiler Plugin with Java 8 Toolchain -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <source>1.8</source>
                    <target>1.8</target>
                    <encoding>${project.build.sourceEncoding}</encoding>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
