<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.nyx1024.petrified</groupId>
    <artifactId>petrified-parent</artifactId>
    <version>2.0.0</version>
    <packaging>pom</packaging>
    <name>Petrified Unified Parent</name>
    <description>Merged Weeping Angels plugin with quantum locking, pathfinding, and cross-version support from 1.8.8 to 1.21.11+</description>

    <modules>
        <module>petrified-core</module>
        <module>petrified-impl-legacy</module>
        <module>petrified-impl-v1_20_R1</module>
        <module>petrified-impl-v1_21_R1</module>
        <module>petrified-plugin</module>
    </modules>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <maven.compiler.plugin.version>3.13.0</maven.compiler.plugin.version>
        <maven.shade.plugin.version>3.6.2</maven.shade.plugin.version>
        <mc.target>1_21_11</mc.target>
        
        <!-- API Versions -->
        <spigot.api.1_8>1.8.8-R0.1-SNAPSHOT</spigot.api.1_8>
        <spigot.api.1_12>1.12.2-R0.1-SNAPSHOT</spigot.api.1_12>
        <spigot.api.1_16>1.16.5-R0.1-SNAPSHOT</spigot.api.1_16>
        <paper.api.1_20_R1>1.20.1-R0.1-SNAPSHOT</paper.api.1_20_R1>
        <paper.api.1_21_R1>1.21.1-R0.1-SNAPSHOT</paper.api.1_21_R1>
        
        <!-- Java Versions per Era -->
        <java.version.legacy>8</java.version.legacy>
        <java.version.modern>17</java.version.modern>
        <java.version.contemporary>21</java.version.contemporary>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.nyx1024.petrified</groupId>
                <artifactId>petrified-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.nyx1024.petrified</groupId>
                <artifactId>petrified-impl-legacy</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.nyx1024.petrified</groupId>
                <artifactId>petrified-impl-v1_20_R1</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.nyx1024.petrified</groupId>
                <artifactId>petrified-impl-v1_21_R1</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.jetbrains</groupId>
                <artifactId>annotations</artifactId>
                <version>24.0.1</version>
                <scope>provided</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <repositories>
        <repository>
            <id>papermc</id>
            <url>https://repo.papermc.io/repository/maven-public/</url>
        </repository>
        <repository>
            <id>spigotmc</id>
            <url>https://hub.spigotmc.org/nexus/content/repositories/snapshots/</url>
        </repository>
    </repositories>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>${maven.compiler.plugin.version}</version>
                    <configuration>
                        <encoding>${project.build.sourceEncoding}</encoding>
                        <showDeprecation>true</showDeprecation>
                        <showWarnings>true</showWarnings>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-shade-plugin</artifactId>
                    <version>${maven.shade.plugin.version}</version>
                    <configuration>
                        <createDependencyReducedPom>false</createDependencyReducedPom>
                        <minimizeJar>false</minimizeJar>
                        <shadedArtifactAttached>false</shadedArtifactAttached>
                        <filters>
                            <filter>
                                <artifact>*:*</artifact>
                                <excludes>
                                    <exclude>META-INF/MANIFEST.MF</exclude>
                                    <exclude>META-INF/*.SF</exclude>
                                    <exclude>META-INF/*.DSA</exclude>
                                    <exclude>META-INF/*.RSA</exclude>
                                    <exclude>**/module-info.class</exclude>
                                </excludes>
                            </filter>
                        </filters>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

    <profiles>
        <!-- Legacy 1.8.8 - 1.16.5 (Java 8 floor) -->
        <profile>
            <id>mc-1_16_5</id>
            <activation><property><name>mc.target</name><value>1_16_5</value></property></activation>
            <properties>
                <java.release>${java.version.legacy}</java.release>
                <spigot.api.version>${spigot.api.1_16}</spigot.api.version>
            </properties>
        </profile>
        <profile>
            <id>mc-1_12_2</id>
            <activation><property><name>mc.target</name><value>1_12_2</value></property></activation>
            <properties>
                <java.release>${java.version.legacy}</java.release>
                <spigot.api.version>${spigot.api.1_12}</spigot.api.version>
            </properties>
        </profile>
        <profile>
            <id>mc-1_8_8</id>
            <activation><property><name>mc.target</name><value>1_8_8</value></property></activation>
            <properties>
                <java.release>${java.version.legacy}</java.release>
                <spigot.api.version>${spigot.api.1_8}</spigot.api.version>
            </properties>
        </profile>
        
        <!-- Modern 1.17.1 - 1.20.4 (Java 17 floor) -->
        <profile>
            <id>mc-1_20_1</id>
            <activation><property><name>mc.target</name><value>1_20_1</value></property></activation>
            <properties>
                <java.release>${java.version.modern}</java.release>
                <paper.api.version>${paper.api.1_20_R1}</paper.api.version>
            </properties>
        </profile>
        
        <!-- Contemporary 1.21+ (Java 21 floor) -->
        <profile>
            <id>mc-1_21_11</id>
            <activation>
                <property><name>mc.target</name><value>1_21_11</value></property>
            </activation>
            <properties>
                <java.release>${java.version.contemporary}</java.release>
                <paper.api.version>${paper.api.1_21_R1}</paper.api.version>
            </properties>
        </profile>
        <profile>
            <id>mc-1_21_1</id>
            <activation><property><name>mc.target</name><value>1_21_1</value></property></activation>
            <properties>
                <java.release>${java.version.contemporary}</java.release>
                <paper.api.version>${paper.api.1_21_R1}</paper.api.version>
            </properties>
        </profile>
    </profiles>
</project>
